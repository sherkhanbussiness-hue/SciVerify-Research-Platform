# SciVerify environment template
# Copy this file to .env for local development and fill in values locally.
# Never commit .env or any other file containing real credentials.

# Required only when using the shared API/database scaffold.
DATABASE_URL=

# The web workflow supplies these automatically. Set them only for manual local runs.
PORT=
BASE_PATH=/

# Optional API server settings.
NODE_ENV=development
LOG_LEVEL=info
REPL_ID=

# Which LLM provider to use: "openai" (default) or "groq".
AGENT_PROVIDER=openai

# ── OpenAI provider ──────────────────────────────────────────────────
# LLM/agent API key for the SciVerify agent runner. Never commit a real value.
OPENAI_API_KEY=

# Optional OpenAI-compatible API base (default https://api.openai.com/v1).
OPENAI_BASE_URL=

# Model id sent to the LLM API (default gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# ── Groq provider (set AGENT_PROVIDER=groq to use) ──────────────────
GROQ_API_KEY=

# Optional Groq-compatible API base (default https://api.groq.com/openai/v1).
GROQ_BASE_URL=

# Model id for Groq (default llama-3.1-8b-instant, which is free-tier).
GROQ_MODEL=llama-3.1-8b-instant

# Python executable used by the sandbox subprocess (default python on Windows, python3 elsewhere).
PYTHON_BIN=

# Comma-separated allowed frontend origins for CORS. Leave blank to allow any origin (local/dev).
CORS_ORIGIN=

# Set to 1 to skip the live LLM and run the pinned physics solver in the sandbox (local verification only).
SCIVERIFY_STUB_AGENT=

# Frontend: origin of the API server, with no trailing slash (example http://localhost:8080).
VITE_API_BASE_URL=http://localhost:8080