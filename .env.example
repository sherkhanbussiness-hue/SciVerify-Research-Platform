# SciVerify environment template
# Copy this file to .env for local development and fill in values locally.
# Never commit .env or any other file containing real credentials.

# Required only when using the shared API/database scaffold.
DATABASE_URL=

# The web workflow supplies these automatically. Set them only for manual local runs.
PORT=
BASE_PATH=/

# Optional API server settings.
NODE_ENV=development
LOG_LEVEL=info
REPL_ID=